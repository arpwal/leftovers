# Homebrew cask for the arpwal/homebrew-tap repository.
# Generated by scripts/update-cask.sh; do not edit the version or sha256 by hand.
cask "leftovers" do
  version "__VERSION__"
  sha256 "__SHA256__"

  url "https://github.com/arpwal/leftovers/releases/download/v#{version}/Leftovers.dmg"
  name "Leftovers"
  desc "Menu-bar app that cleans up what apps and coding agents left running"
  homepage "https://arpwal.github.io/leftovers/"

  depends_on macos: :sonoma

  app "Leftovers.app"

  # The fseventsd helper is a launchd daemon registered by the app (SMAppService);
  # stop and remove it with the app so it doesn't outlive it.
  uninstall quit:      "com.arpwal.leftovers",
            launchctl: "com.arpwal.leftovers.helper"

  zap launchctl: "com.arpwal.leftovers.helper",
      trash:     [
        "~/Library/Application Support/Leftovers",
        "~/Library/Preferences/com.arpwal.leftovers.plist",
      ]
end
